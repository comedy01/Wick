{
	"schemaVersion": 1,
	"id": "wick",
	"version": "${version}",
	"name": "Wick",
	"description": "Dynamic lights. Hold a torch, lantern or lava bucket and the world lights up around you as you walk. Dropped torches, burning mobs and blazes shine too. Client-side only.",
	"icon": "assets/wick/icon128.png",
	"authors": [
		"comedy01"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/comedy01/Wick",
		"sources": "https://github.com/comedy01/Wick",
		"issues": "https://github.com/comedy01/Wick/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.wick.fabric.WickFabric"
		],
		"modmenu": [
			"dev.wick.fabric.WickModMenu"
		]
	},
	"mixins": [
		"wick.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabric_loader_min}",
		"${fabric_api_id}": "*",
		"minecraft": "${range}",
		"java": ">=${java_version}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
